# Banco de dados (PostgreSQL)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=c216
POSTGRES_PORT=5432

# Backend (FastAPI)
BACKEND_PORT=8000

# Conexão do SQLAlchemy com o PostgreSQL. O env_file do Compose NÃO expande
# ${VAR} dentro do próprio .env, então o valor abaixo precisa repetir, de
# forma literal, o mesmo usuário/senha/banco definidos acima. Dentro da rede
# do Docker Compose o host é o nome do serviço ("db"), nunca "localhost" —
# os comandos nativos (make test, make run, make db-*) resolvem o host como
# "localhost" sozinhos, a partir das variáveis POSTGRES_* acima.
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/c216

# Origens permitidas pelo CORS do backend (lista separada por vírgula).
# O curinga "*" é recusado de propósito: informe sempre origens explícitas.
CORS_ORIGINS=http://localhost:5173

# Frontend (Vite)
FRONTEND_PORT=5173
# URL da API vista pelo NAVEGADOR (por isso localhost, não o nome do serviço).
VITE_API_URL=http://localhost:8000
