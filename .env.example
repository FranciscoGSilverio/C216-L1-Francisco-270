# Valores de desenvolvimento local: funcionam sem edição (make env copia este
# arquivo para .env, que não é versionado). Troque a senha se expuser o banco.

# Banco de dados (PostgreSQL)
POSTGRES_USER=cinema
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=cinema
POSTGRES_PORT=5432

# Backend (FastAPI). A DATABASE_URL é montada pelo Compose a partir das
# variáveis POSTGRES_* acima; não precisa ser definida aqui.
BACKEND_PORT=8000

# Origens permitidas pelo CORS (lista separada por vírgula).
# O curinga "*" é recusado de propósito: informe sempre origens explícitas.
CORS_ORIGINS=http://localhost:5173

# Frontend (Vite)
FRONTEND_PORT=5173
# URL da API vista pelo NAVEGADOR (por isso localhost, não o nome do serviço).
VITE_API_URL=http://localhost:8000
